{% extends "store/base.html" %}

{% block title %}Track Your Order | Shyam Store{% endblock %}

{% block content %}
<div style="max-width:750px;margin:25px auto;">
    <div style="background:linear-gradient(120deg,#e5f5e9,#f4f8df);border-radius:18px;padding:30px;margin-bottom:25px;">
        <h1 style="font-size:30px;">📦 Track Your Order</h1>
        <p style="margin-top:8px;color:#526359;">Enter your order number and checkout email to see the latest status.</p>
    </div>

    <section style="background:white;border:1px solid #e7ece8;border-radius:15px;padding:25px;">
        <form method="post">
            {% csrf_token %}

            <label for="order_id" style="display:block;font-weight:600;margin-bottom:7px;">Order Number</label>
            <input id="order_id" type="number" min="1" name="order_id" value="{{ request.POST.order_id }}" required style="width:100%;padding:12px;border:1px solid #dce5de;border-radius:8px;margin-bottom:18px;box-sizing:border-box;">

            <label for="email" style="display:block;font-weight:600;margin-bottom:7px;">Email Address Used at Checkout</label>
            <input id="email" type="email" name="email" value="{{ request.POST.email }}" required style="width:100%;padding:12px;border:1px solid #dce5de;border-radius:8px;margin-bottom:20px;box-sizing:border-box;">

            <button type="submit" class="btn" style="width:100%;border:0;cursor:pointer;">Track Order →</button>
        </form>

        {% if error %}
            <p style="margin-top:18px;padding:12px;background:#fff0ef;color:#b42318;border-radius:8px;">{{ error }}</p>
        {% endif %}

        {% if order %}
            <div style="margin-top:25px;border-top:1px solid #e7ece8;padding-top:22px;">
                <h2 style="font-size:22px;margin-bottom:15px;">Order #{{ order.id }}</h2>

                <p><strong>Customer:</strong> {{ order.customer_name }}</p>
                <p style="margin-top:8px;"><strong>Order Date:</strong> {{ order.created_at|date:"d M Y, h:i A" }}</p>
                <p style="margin-top:8px;"><strong>Total:</strong> ₹{{ order.total_amount|floatformat:2 }}</p>

                <div style="margin:20px 0;padding:18px;background:#eaf6ef;border-radius:10px;">
                    <p style="font-weight:600;">Current Status</p>
                    <p style="font-size:22px;font-weight:700;color:#176b45;margin-top:5px;">{{ order.get_status_display }}</p>
                </div>

                <h3 style="margin-bottom:12px;">Items Ordered</h3>
                {% for item in order.items.all %}
                    <div style="display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #edf0ed;">
                        <span>{{ item.product.name }} × {{ item.quantity }}</span>
                        <strong>₹{{ item.price|floatformat:2 }}</strong>
                    </div>
                {% empty %}
                    <p>No order items found.</p>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <p style="margin-top:20px;"><a href="{% url 'product_list' %}" style="color:#176b45;font-weight:600;">← Continue Shopping</a></p>
</div>
{% endblock %}
